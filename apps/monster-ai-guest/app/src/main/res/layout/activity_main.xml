<?xml version="1.0" encoding="utf-8"?>
<!-- 主畫面｜開發者：Suckbob｜發行商：Monster_Ai_hk -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 試玩橫幅 -->
        <TextView
            android:id="@+id/tvBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_banner"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/guest_banner"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/app_name"
            android:textColor="@color/neon_cyan"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- 倒數計時器（明顯） -->
        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_timer"
            android:gravity="center"
            android:padding="14dp"
            android:textColor="@color/neon_cyan"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="剩餘試玩 30:00" />

        <TextView
            android:id="@+id/tvMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="開發者：Suckbob｜發行商：Monster_Ai_hk" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/select_character"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCharacters"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            tools:listitem="@layout/item_character" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/locked_section"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvLockedHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="更多角色 · 自訂角色 · 雲端角色庫" />

        <Button
            android:id="@+id/btnOfficial"
            style="@style/Widget.Monster.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="28dp"
            android:text="@string/official_cta" />
    </LinearLayout>

    <!-- 右下角常駐半透明浮水印 -->
    <TextView
        android:id="@+id/tvWatermark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="12dp"
        android:alpha="0.55"
        android:textColor="@color/watermark"
        android:textSize="11sp"
        tools:text="訪客試玩版｜Monster_Ai_hk" />
</FrameLayout>
